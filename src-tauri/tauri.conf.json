{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stem Splitter",
  "version": "0.1.0",
  "identifier": "com.stemsplitter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stem Splitter",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: blob: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/stem-splitter-sidecar",
      "binaries/ffmpeg"
    ],
    "category": "Music",
    "shortDescription": "Separa músicas do YouTube em 6 stems",
    "longDescription": "Baixa do YouTube e separa em vocal, bateria, baixo, guitarra, piano e outros usando Demucs."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
